@page "/draggable-nodes"

<PageTitle>Draggable Nodes - Blazor-ApexSankey Demo</PageTitle>

<div class="demo-page">
    <h1>Draggable Nodes</h1>
    <p class="description">
        Set <code>DraggableNodes = true</code> to let users reposition nodes by dragging (mouse, touch, or pen). The
        connected flows follow the node live; the manual position holds until the next render recomputes the layout.
        <strong>Try dragging a node.</strong>
    </p>

    <div class="controls-panel">
        <h3>Options</h3>
        <div class="controls-row">
            <div class="control-group">
                <label>
                    <input type="checkbox" @bind="_draggable" @bind:after="UpdateOptions" />
                    Draggable nodes
                </label>
            </div>
        </div>
    </div>

    <div class="chart-container">
        <ApexSankey Data="@_data" Options="@_options" Style="margin: 0 auto; width: 800px; height: 500px;" />
    </div>

    <div class="code-section">
        <h3>Code</h3>
        <pre><code>@_code</code></pre>
    </div>
</div>

@code {
    private bool _draggable = true;
    private readonly SankeyData _data = DemoData.EnergyMix();

    private SankeyOptions _options = new() { DraggableNodes = true, Height = "500" };

    private void UpdateOptions()
    {
        _options = new SankeyOptions { DraggableNodes = _draggable, Height = "500" };
    }

    private readonly string _code = @"var options = new SankeyOptions
{
    DraggableNodes = true
};";
}
