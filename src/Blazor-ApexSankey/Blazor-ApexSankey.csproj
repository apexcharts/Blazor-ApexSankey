<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Blazor_ApexSankey</RootNamespace>
    <AssemblyName>Blazor-ApexSankey</AssemblyName>
    
    <!-- NuGet Package Configuration -->
    <PackageId>Blazor-ApexSankey</PackageId>
    <Version>1.2.1</Version>
    <Authors>ApexCharts</Authors>
    <Company>ApexCharts</Company>
    <Product>Blazor-ApexSankey</Product>
    <Description>A Blazor component library for creating interactive Sankey diagrams using ApexSankey. Supports WebAssembly with two-way data binding, customizable styling, and event handling.</Description>
    <PackageTags>blazor;sankey;chart;diagram;visualization;apexcharts;webassembly;wasm;component</PackageTags>
    <PackageProjectUrl>https://github.com/apexcharts/Blazor-ApexSankey</PackageProjectUrl>
    <RepositoryUrl>https://github.com/apexcharts/Blazor-ApexSankey</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!--
      The LICENSE file, not an SPDX expression. This package embeds the ApexSankey engine
      (wwwroot/apexsankey.min.js) as a static web asset, so the declared licence covers that
      engine as well as the C# wrapper. ApexSankey is commercial, Pro plan and above, with no
      free tier, which no SPDX expression can express and which MIT actively contradicts.
    -->
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright © ApexCharts 2025</Copyright>
    <PackageReleaseNotes>1.2.1 Corrects the package licence metadata. Releases up to and including 1.2.0 declared the SPDX expression MIT, which was wrong: this package embeds the ApexSankey engine, and ApexSankey is a commercial product included in the Pro plan and above with no free tier. The LICENSE file in the repository always stated those terms, so the package contradicted its own licence document. 1.2.1 declares the LICENSE file itself and ships it inside the package. No code changes.

      1.2.0 Ports the apexsankey 1.11.0 option surface into the C# model: type (chord), arcCornerRadius, theme (named or inline SankeyTheme) and nodePalette, orientation, whitespace, axisTitles, viewPortWidth/Height, draggableNodes, particleFlow, nodeTooltipTemplate, tooltipTheme, tooltipFontColor, and a11y. Adds a Plugins option to install the built-in path tracing, time playback, and drill-down plugins. Non-breaking over 1.1.0.</PackageReleaseNotes>

    <!-- Package Settings -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
